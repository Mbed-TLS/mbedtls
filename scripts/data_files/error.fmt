#include "mbedtls_common.h"

#include "mbedtls/error.h"

#if defined(MBEDTLS_ERROR_C) || defined(MBEDTLS_ERROR_STRERROR_DUMMY)

#if defined(MBEDTLS_ERROR_C)

#include "mbedtls/platform.h"

#include <stdio.h>
#include <string.h>

HEADER_INCLUDED

static const char *mbedtls_error_description(int error_code)
{
    switch (error_code) {
    /* Begin Auto-Generated Code. */
    HIGH_LEVEL_CODE_CHECKS
    LOW_LEVEL_CODE_CHECKS
        /* End Auto-Generated Code. */

        default:
            break;
    }

    return NULL;
}

void mbedtls_strerror(int ret, char *buf, size_t buflen)
{
    const char *description;

    if (buflen == 0) {
        return;
    }

    memset(buf, 0x00, buflen);

    if (ret == 0) {
        return;
    }

    description = mbedtls_error_description(ret);

    if (description == NULL) {
        /* Not an MBEDTLS_ERR_xxx constant. Error codes are negative:
         * print the absolute value. */
        mbedtls_snprintf(buf, buflen, "UNKNOWN ERROR CODE (%04X)",
                         ret < 0 ? 0u - (unsigned int) ret : (unsigned int) ret);
    } else {
        mbedtls_snprintf(buf, buflen, "%s", description);
    }
}

#else /* MBEDTLS_ERROR_C */

/*
 * Provide a dummy implementation when MBEDTLS_ERROR_C is not defined
 */
void mbedtls_strerror(int ret, char *buf, size_t buflen)
{
    ((void) ret);

    if (buflen > 0) {
        buf[0] = '\0';
    }
}

#endif /* MBEDTLS_ERROR_C */

#endif /* MBEDTLS_ERROR_C || MBEDTLS_ERROR_STRERROR_DUMMY */
